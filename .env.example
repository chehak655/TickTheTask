# ==========================================
# TaskFlow - Environment Variables Example
# ==========================================
# Do NOT place actual secrets (like App Passwords or DB passwords) in this file.
# Copy this file to `backend/.env` (and similarly for web/mobile if needed) and fill in your details.

# ------------------------------------------
# Backend (.env)
# ------------------------------------------
# Environment Mode (dev or prod)
ENVIRONMENT=dev

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=taskflow_db

# Security Configuration
# Generate a strong 32+ character key for production (e.g., openssl rand -hex 32)
SECRET_KEY=replace_this_with_a_long_secure_random_string
ALGORITHM=HS256

# Email / SMTP Configuration (For OTP & Reminders)
EMAIL_ENABLED=True
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Use your real Gmail address
SMTP_USERNAME=your_email@gmail.com
# Use the 16-character Google App Password (NOT your actual Gmail password)
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="TaskFlow System"

# ------------------------------------------
# Web (.env) - Optional overrides
# ------------------------------------------
# The web app natively resolves the local host, but you can explicitly override the backend URL here:
VITE_API_URL=http://localhost:8000

# ------------------------------------------
# Mobile (.env) - Optional overrides
# ------------------------------------------
# The Expo app resolves host URIs dynamically, but you can force an API URL here:
EXPO_PUBLIC_API_URL=http://192.168.1.X:8000
