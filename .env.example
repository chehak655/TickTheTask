# ==========================================
# TickTheTask - Environment Variables Example
# ==========================================
# Do NOT place actual secrets (like App Passwords or DB passwords) in this file.
# Copy this file to `backend/.env` (and similarly for web/mobile if needed) and fill in your details.

# ------------------------------------------
# Backend (.env)
# ------------------------------------------
# Environment Mode (dev or prod)
ENVIRONMENT=dev

# Database Configuration (PostgreSQL via Docker)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=tickthetask
DB_PASSWORD=your_postgres_password
DB_NAME=tickthetask_db
DATABASE_URL=postgresql+psycopg2://tickthetask:your_postgres_password@127.0.0.1:5432/tickthetask_db

# Security Configuration
# Generate a strong 32+ character key for production: openssl rand -hex 32
SECRET_KEY=replace_this_with_a_long_secure_random_string
ALGORITHM=HS256

# ------------------------------------------
# Web (.env) - Optional overrides
# ------------------------------------------
# The web app natively resolves the local host, but you can explicitly override the backend URL here:
VITE_API_URL=http://localhost:8000
