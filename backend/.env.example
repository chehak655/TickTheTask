# TickTheTask Backend Environment Configuration

PROJECT_NAME="TickTheTask API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT=development

# Database Configuration (MySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tickthetask_db

# Direct SQLAlchemy Database URL override (optional)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/tickthetask_db

# JWT Security
# Generate a production secret key with: openssl rand -hex 32
# In production, SECRET_KEY must be a unique, 32+ character string.
SECRET_KEY=your_secure_random_secret_key_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Explicit CORS Allowed Origins
# Specify comma-separated list or JSON array of trusted frontend domains
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","http://localhost:8081","http://localhost:19006"]

# Email & SMTP Delivery Configuration (Gmail)
# To enable real email delivery:
# 1. Set EMAIL_ENABLED=True
# 2. Set SMTP_USERNAME to your full Gmail address
# 3. Generate a 16-character Google App Password (myaccount.google.com -> Security -> 2-Step Verification -> App passwords)
# 4. Set SMTP_PASSWORD to your 16-character App Password (without spaces)
EMAIL_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_google_app_password
SMTP_FROM_EMAIL=your_gmail_address@gmail.com
SMTP_FROM_NAME="TickTheTask"
SMTP_TLS=True
SMTP_TIMEOUT_SECONDS=15
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
RESEND_VERIFICATION_COOLDOWN_SECONDS=60
